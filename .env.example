# 程序启动时读取当前工作目录下的 .env。
# 只补充缺失的环境变量，不覆盖 shell 中已存在的同名变量。
# 本文件只是示例，不要写入真实密钥；.env 已被 .gitignore 忽略。

# DeepSeek（默认提供方）
DEEPSEEK_API_KEY=your_deepseek_api_key
# 默认模型为 deepseek-flash，通常无需设置
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 其他 OpenAI 兼容接口
# DUALPATH_PROVIDER=openai-compatible
# DUALPATH_API_KEY=your_api_key
# DUALPATH_BASE_URL=https://your-endpoint.example/v1
# DUALPATH_MODEL=your_model_name
